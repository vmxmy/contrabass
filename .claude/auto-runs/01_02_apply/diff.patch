	ProtocolVersion ProtocolVersion `json:"protocol_version"`

	// RefreshToken corresponds to the JSON schema field "refreshToken".
	RefreshToken BearerToken `json:"refreshToken"`
}

// POST /v1/workers/refresh success response (HTTP 200) and structured error
