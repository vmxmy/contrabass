	// IssueRef corresponds to the JSON schema field "issueRef".
	IssueRef IssueRef `json:"issueRef"`

	// LeaseSec corresponds to the JSON schema field "leaseSec".
	LeaseSec LeaseSec `json:"leaseSec"`

	// Rendered Liquid template from active config (no secret references).
	Prompt string `json:"prompt"`

	// ProtocolVersion corresponds to the JSON schema field "protocol_version".
	ProtocolVersion ProtocolVersion `json:"protocol_version"`

	// RunID corresponds to the JSON schema field "runId".
	RunID RunID `json:"runId"`

	// Type corresponds to the JSON schema field "type".
	Type string `json:"type"`
}

// R2 presigned PUT URLs valid for the lease duration. Workers MUST upload large
// outputs here, NOT via the events endpoint.
type WorkerDispatchFrameArtifactUploadURLs struct {
	// Diff corresponds to the JSON schema field "diff".
	Diff URL `json:"diff"`

	// Logs corresponds to the JSON schema field "logs".
	Logs URL `json:"logs"`

	// Screenshots corresponds to the JSON schema field "screenshots".
	Screenshots []URL `json:"screenshots,omitempty,omitzero"`

	// Summary corresponds to the JSON schema field "summary".
	Summary URL `json:"summary"`
}

// Schema for ONE NDJSON line of POST /v1/runs/{runId}/events (Content-Type:
// application/x-ndjson). Per-kind payload shapes are sealed via discriminated
// oneOf. The endpoint accepts up to 200 lines or 512 KiB total per request — see
// events-request.json for the logical batch contract used by tests and golden
// fixtures.
