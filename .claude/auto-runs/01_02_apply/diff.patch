	Version string `json:"version"`

	// WorkerID corresponds to the JSON schema field "workerId".
	WorkerID WorkerID `json:"workerId"`
}

type WorkerRegisterRequestKind string

const WorkerRegisterRequestKindContainer WorkerRegisterRequestKind = "container"
const WorkerRegisterRequestKindLocal WorkerRegisterRequestKind = "local"

// POST /v1/workers/register success response (HTTP 200) and structured error
