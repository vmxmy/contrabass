	LeaseSec LeaseSec `json:"leaseSec"`

	// ProtocolVersion corresponds to the JSON schema field "protocol_version".
	ProtocolVersion ProtocolVersion `json:"protocol_version"`

	// RefreshToken corresponds to the JSON schema field "refreshToken".
	RefreshToken BearerToken `json:"refreshToken"`

	// SessionToken corresponds to the JSON schema field "sessionToken".
