				"issueRef":         "LIN-123",
				"branch":           "feature/lin-123",
				"prompt":           "fix the issue",
				"configHash":       "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
				"leaseSec":         float64(60),
			},
		},
	}

