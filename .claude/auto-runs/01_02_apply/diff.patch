// Logical decoded form of POST /v1/runs/{runId}/events for tests and golden
// fixtures. The wire format is NDJSON (Content-Type: application/x-ndjson, one
// JSON object per line). The maxBytes server invariant (524288) is HTTP-byte
// counted and cannot be enforced by JSON Schema — see events.json $defs.Limits.
type WorkerEventsRequest []WorkerEventLine

// POST /v1/runs/{runId}/heartbeat — worker extends the lease for an active run.
// Cadence ≤ heartbeatIntervalSec from register response. See worker-protocol spec:
// 'Heartbeat and lease extension'.
type WorkerHeartbeatRequest struct {
	// LastEventTs corresponds to the JSON schema field "lastEventTs".
	LastEventTs EpochMillis `json:"lastEventTs"`

	// Short human-readable phase label (e.g., 'planning', 'editing', 'verifying').
	Progress *string `json:"progress,omitempty,omitzero"`

	// ProtocolVersion corresponds to the JSON schema field "protocol_version".
	ProtocolVersion ProtocolVersion `json:"protocol_version"`
}

type WorkerID string

// POST /v1/workers/refresh request body. See worker-protocol spec: 'Session
