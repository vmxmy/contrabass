{
  "name": "@contrabass/cloud",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run",
    "dev": "wrangler dev",
    "migrate": "wrangler d1 migrations apply CONTROL_PLANE_DB",
    "migrate:create": "wrangler d1 migrations create CONTROL_PLANE_DB",
    "migrate:list": "wrangler d1 migrations list CONTROL_PLANE_DB",
    "seed:synthetic": "wrangler d1 execute CONTROL_PLANE_DB --file ./seeds/synthetic-team.sql",
    "secrets:store:create": "wrangler secrets-store store create default_secrets_store --remote",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "plane:issue": "node scripts/plane-issue.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260508.1",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "esbuild": "^0.28.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.5.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5",
    "wrangler": "^4.90.0"
  },
  "dependencies": {
    "hono": "^4.12.18",
    "liquidjs": "^10.25.7",
    "yaml": "^2.7.1"
  }
}
