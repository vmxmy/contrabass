{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contrabass.dev/schemas/worker-protocol/v1/ack.json",
  "title": "WorkerAckRequest",
  "description": "POST /v1/runs/{runId}/ack — worker accepts or rejects a dispatch within ackDeadlineSec (default 5s). See worker-protocol spec: 'Dispatch acknowledgement'.",
  "type": "object",
  "additionalProperties": false,
  "required": ["accept", "protocol_version"],
  "properties": {
    "accept": { "type": "boolean" },
    "reason": {
      "type": "string",
      "enum": [
        "at_capacity",
        "missing_capability",
        "config_hash_unknown",
        "worker_shutting_down",
        "other"
      ],
      "description": "Required when accept=false. Cloud uses to skip this worker on retry."
    },
    "reasonDetail": {
      "type": "string",
      "maxLength": 512
    },
    "protocol_version": { "$ref": "_common.json#/$defs/ProtocolVersion" }
  },
  "if": {
    "properties": { "accept": { "const": false } },
    "required": ["accept"]
  },
  "then": {
    "required": ["accept", "reason", "protocol_version"]
  },
  "$defs": {
    "ErrorCode": {
      "type": "string",
      "enum": [
        "lease_already_held",
        "lease_revoked",
        "run_unknown"
      ]
    }
  }
}
